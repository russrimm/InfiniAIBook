# ---------------------------------------------------------------------------
# Lingua — realtime conversation tutor
# ---------------------------------------------------------------------------
# Models:
#   Realtime ......... AZURE_OPENAI_REALTIME_DEPLOYMENT: the voice conversation (required)
#   Transcription .... AZURE_OPENAI_TRANSCRIPTION_MODEL: learner captions (optional)
#   Chat ............. AZURE_OPENAI_DEPLOYMENT: translations and session recaps (optional)
# ---------------------------------------------------------------------------

# A) Azure OpenAI / Microsoft Foundry. The realtime deployment must be in a
#    region that offers it (East US 2 or Sweden Central for global deployments).
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com

# Realtime model deployment name: gpt-realtime, gpt-realtime-2.1,
# gpt-realtime-2.1-mini, gpt-realtime-mini ...
AZURE_OPENAI_REALTIME_DEPLOYMENT=gpt-realtime

# Transcribes what the learner says so it appears in the transcript and can be
# corrected. A transcription model name such as gpt-4o-transcribe,
# gpt-4o-mini-transcribe or whisper-1. Unset uses gpt-4o-mini-transcribe;
# set to "off" to disable learner captions.
# AZURE_OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe

# Chat deployment for transcript translations and the end-of-session recap.
# Without it the conversation still works; translations and recaps are off.
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini

# Authentication: Microsoft Entra ID by default. Locally, run `az login`; the
# identity needs "Cognitive Services OpenAI User" on the resource. On Azure,
# use a managed identity with the same role.
# AZURE_CLIENT_ID=                 # user-assigned managed identity, or with the two below
# AZURE_TENANT_ID=
# AZURE_CLIENT_SECRET=
# Token scope; the default works for *.openai.azure.com and
# *.cognitiveservices.azure.com endpoints.
# AZURE_OPENAI_TOKEN_SCOPE=https://cognitiveservices.azure.com/.default
#
# Or a key instead of Entra:
# AZURE_OPENAI_API_KEY=

# B) OpenAI directly (used only when AZURE_OPENAI_ENDPOINT is unset).
# OPENAI_API_KEY=
# The three model variables above are then OpenAI model names, e.g.
# AZURE_OPENAI_REALTIME_DEPLOYMENT=gpt-realtime and AZURE_OPENAI_DEPLOYMENT=gpt-5-mini.

# ---------------------------------------------------------------------------
# Access
# ---------------------------------------------------------------------------
# Optional password (HTTP Basic auth, any username). Without it, only
# localhost and ALLOWED_HOSTS are served.
# LINGUA_PASSWORD=
# ALLOWED_HOSTS=lingua.example.com
# TRUST_PROXY=false

# Where the SQLite database lives (defaults to ./.data).
# DATA_DIR=./.data
